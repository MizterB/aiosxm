{
	"name": "aiosxm",
	"image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
	"postCreateCommand": "pip3 install --user uv && uv sync --dev",
	"forwardPorts": [8080],
	"portsAttributes": {
		"8080": {
			"label": "aiosxm proxy"
		}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-python.python",
				"charliermarsh.ruff"
			],
			"settings": {
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
			}
		}
	}
}
