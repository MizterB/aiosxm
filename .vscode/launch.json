{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "SiriusXM proxy",
            "type": "debugpy",
            "request": "launch",
            "module": "aiosxm",
            "args": ["--verbose"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-q"],
            "console": "integratedTerminal",
            "justMyCode": false
        },
        {
            "name": "Tests (live API)",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["--live", "-q"],
            "console": "integratedTerminal",
            "justMyCode": false
        }
    ]
}
